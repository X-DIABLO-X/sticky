{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky",
  "version": "0.1.0",
  "identifier": "com.heyclicky.clone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "dashboard",
        "title": "Sticky — Desktop AI Control Center",
        "url": "index.html?window=dashboard",
        "width": 1140,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "shadow": true,
        "visible": true,
        "center": true
      },
      {
        "label": "pill",
        "title": "Sticky Pill",
        "url": "index.html?window=pill",
        "width": 320,
        "height": 52,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "bubble",
        "title": "Sticky Bubble",
        "url": "index.html?window=bubble",
        "width": 280,
        "height": 68,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "overlay",
        "title": "Sticky Overlay",
        "url": "index.html?window=overlay",
        "fullscreen": false,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "quick_input",
        "title": "Sticky Command Palette",
        "url": "index.html?window=quick_input",
        "width": 640,
        "height": 340,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://api.groq.com https://generativelanguage.googleapis.com https://openrouter.ai; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
