# ==============================================================================
# HeyClicky Desktop Assistant - Environment Configuration Template
# Copy this file to .env or ~/.heyclicky/.env and fill in optional API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hardware Profile & Privacy Mode
# ------------------------------------------------------------------------------
# Profile presets:
#   - laptop_6gb            : RTX 3050/4050/4060 (Silero + Moonshine + Kokoro on CPU, Qwen3-VL-4B on GPU)
#   - cpu_only_hybrid       : Ultrabook / iGPU (Local CPU audio + Groq/Gemini free-tier cloud escalation)
#   - workstation_16gb_plus : 16+ GB VRAM (Full local models: UI-TARS-1.5-7B, Chatterbox-Turbo, OmniParser)
CLICKY_PROFILE=laptop_6gb

# Privacy Mode:
#   - hybrid_free : Local audio DSP + zero-cost free cloud APIs (Groq, Gemini, OpenRouter) [Default]
#   - local_only  : 100% air-gapped local execution (llama.cpp / ONNX) - zero external requests
CLICKY_PRIVACY_MODE=hybrid_free


# ------------------------------------------------------------------------------
# 2. Zero-Cost Cloud API Keys (Optional - Free Tier Escalation)
# ------------------------------------------------------------------------------
# Groq Cloud API (30 RPM, 1,000 RPD free tier: gpt-oss-20b, qwen3.6-27b)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API (15 RPM free tier: gemini-2.5-flash-lite, gemini-2.5-flash)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter Free Pool (20 RPM free tier: gemma-4-31b-it:free, nemotron-3-nano-omni-30b:free)
# Get a free key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=


# ------------------------------------------------------------------------------
# 3. Local Model & Inference Server Endpoints
# ------------------------------------------------------------------------------
# OpenAI-compatible local llama.cpp / llama-server or Ollama endpoint
LOCAL_LLAMA_URL=http://127.0.0.1:8080/v1
LOCAL_LLAMA_MODEL=qwen3-vl-4b-instruct

# Local Python Vision Sidecar (FastAPI + OmniParser v2 + Chatterbox-Turbo stub)
SIDECAR_VISION_URL=http://127.0.0.1:8765

# Local Model Files Directory (Defaults to ~/.heyclicky/models)
CLICKY_MODELS_DIR=~/.heyclicky/models
SILERO_VAD_PATH=~/.heyclicky/models/silero_vad.onnx
MOONSHINE_PATH=~/.heyclicky/models/moonshine_streaming_tiny.onnx
KOKORO_MODEL_PATH=~/.heyclicky/models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=~/.heyclicky/models/voices.json
QWEN_VL_GGUF_PATH=~/.heyclicky/models/qwen3-vl-4b-instruct-q4_k_m.gguf


# ------------------------------------------------------------------------------
# 4. Audio Engine & Real-Time DSP
# ------------------------------------------------------------------------------
# Device selection: use "default" or run with list devices flag
CLICKY_MIC_DEVICE=default
CLICKY_OUTPUT_DEVICE=default
CLICKY_SAMPLE_RATE=16000

# Acoustic Echo Cancellation (sonora WebRTC AEC3 + NS + AGC2)
CLICKY_AEC_ENABLED=true

# Silero VAD sensitivity (0.0 to 1.0) and trailing silence cutoff
CLICKY_VAD_THRESHOLD=0.5
CLICKY_VAD_TRAILING_MS=200

# Kokoro TTS Voice (e.g. af_heart, af_bella, am_adam, am_michael)
CLICKY_TTS_VOICE=af_heart
CLICKY_TTS_SPEED=1.0


# ------------------------------------------------------------------------------
# 5. Global Hotkeys
# ------------------------------------------------------------------------------
# Talk Mode: Hold to speak, release to execute
HOTKEY_TALK=Ctrl+Space

# Dictation: Stream live speech into active caret
HOTKEY_DICTATION=Alt+Shift+D

# Top-Edge Notch / Pill UI toggle
HOTKEY_PILL_TOGGLE=Ctrl+Alt+A

# Quick Input Spotlight prompt bar (double-tap key)
HOTKEY_QUICK_INPUT=Ctrl+Ctrl

# Emergency Interrupt Watchdog (abort AI driving or speech immediately)
HOTKEY_INTERRUPT=Escape


# ------------------------------------------------------------------------------
# 6. Model Context Protocol (MCP) & Tool Integrations
# ------------------------------------------------------------------------------
# Path to ~/.heyclicky/mcp.json defining stdio and HTTP/SSE MCP servers
MCP_CONFIG_PATH=~/.heyclicky/mcp.json

# Optional MCP Tokens (if using remote MCP servers)
GMAIL_MCP_TOKEN=
GITHUB_TOKEN=
NOTION_API_KEY=


# ------------------------------------------------------------------------------
# 7. Logging & Diagnostics
# ------------------------------------------------------------------------------
RUST_LOG=info,heyclicky=debug
CLICKY_LOG_DIR=~/.heyclicky/logs
